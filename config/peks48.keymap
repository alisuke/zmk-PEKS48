#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Conversion definition for using Japanese keyboard with OS settings

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    macros {
        kp_paren: kp_paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;
            label = "KP_PAREN";
        };

        kp_bracket: kp_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_ARROW>;
            label = "KP_BRACKET";
        };

        kp_brace: kp_brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT>;
            label = "KP_BRACE";
        };

        kp_angle: kp_angle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN &kp GREATER_THAN &kp LEFT>;
            label = "KP_ANGLE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC     &kp Q     &kp P        &kp U            &kp Y       &kp SEMICOLON      &kp J      &kp D          &kp H  &kp G           &kp W            &kp SQT
&kp TAB     &kp I     &kp O        &kp E            &kp A       &kp SLASH          &kp K      &kp T          &kp N  &kp S           &kp R            &kp PERIOD
&kp LSHIFT  &kp Z     &kp X        &mt TILDE MINUS  &kp C       &kp EXCLAMATION    &kp M      &kp L          &kp F  &kp B           &kp COMMA        &kp UP_ARROW
&kp LCTRL   &kp LALT  &lt 2 MINUS  &kp LEFT_WIN     &lt 1 CAPS  &kp SPACE          &kp ENTER  &kp BACKSPACE  &kp V  &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp DOWN_ARROW
            >;
        };

        layer_1 {
            bindings = <
&kp EQUAL  &kp PLUS      &kp MINUS  &kp N7        &kp N8        &kp N9          &kp_bracket  &kp_brace  &kp GRAVE             &trans  &trans  &kp HOME
&kp_paren  &kp ASTERISK  &kp SLASH  &kp NUMBER_4  &kp N5        &kp NUMBER_6    &kp_paren    &trans     &kp NON_US_BACKSLASH  &trans  &trans  &kp END
&trans     &kp PERIOD    &kp N0     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &kp_angle    &trans     &trans                &trans  &trans  &trans
&trans     &trans        &trans     &trans        &trans        &trans          &trans       &trans     &trans                &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&kp LA(F4)       &trans  &trans  &trans  &trans       &trans    &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans
&trans           &trans  &trans  &trans  &trans       &trans    &trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans
&kp PRINTSCREEN  &trans  &trans  &trans  &trans       &trans    &trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans
&trans           &trans  &trans  &trans  &lt 3 MINUS  &trans    &trans  &trans  &trans   &trans   &trans   &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans      &trans      &trans  &trans      &bootloader    &trans  &trans  &trans  &trans  &trans  &bootloader
&trans  &bt BT_NXT  &bt BT_PRV  &trans  &bt BT_CLR  &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans      &trans  &trans      &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans      &trans  &trans      &trans         &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
